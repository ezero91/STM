    http://www.matsim.org/files/dtd/vehicleDefinitions_v1.0.xsd">

    <vehicleType id="carrinho">
        <description>Micro-ônibus / Topic</description>
        <capacity>
            <seats persons="14"/>
            <standingRoom persons="10"/>
        </capacity>
        <length meter="6.0"/>
        <width meter="2.0"/>
        <accessTime secondsPerPerson="1.5"/>
        <egressTime secondsPerPerson="1.5"/>
        <doorOperation mode="serial"/>
        <passengerCarEquivalents pce="0.7"/>
    </vehicleType>

    <vehicleType id="etac">
        <description>Ônibus pequeno</description>
        <capacity>
            <seats persons="28"/>
            <standingRoom persons="22"/>
        </capacity>
        <length meter="9.0"/>
        <width meter="2.5"/>
        <accessTime secondsPerPerson="1.2"/>
        <egressTime secondsPerPerson="1.2"/>
        <doorOperation mode="serial"/>
        <passengerCarEquivalents pce="1.0"/>
    </vehicleType>

    <vehicleType id="onibus">
        <description>Ônibus padrão 12m</description>
        <capacity>
            <seats persons="38"/>
            <standingRoom persons="50"/>
        </capacity>
        <length meter="12.0"/>
        <width meter="2.5"/>
        <accessTime secondsPerPerson="0.8"/>
        <egressTime secondsPerPerson="0.8"/>
        <doorOperation mode="parallel"/>
        <passengerCarEquivalents pce="2.0"/>
    </vehicleType>

    <vehicleType id="stec">
        <description>Ônibus Articulado (BRT)</description>
        <capacity>
            <seats persons="54"/>
            <standingRoom persons="110"/>
        </capacity>
        <length meter="18.0"/>
        <width meter="2.6"/>
        <accessTime secondsPerPerson="0.5"/>
        <egressTime secondsPerPerson="0.5"/>
        <doorOperation mode="parallel"/>
        <passengerCarEquivalents pce="3.0"/>
    </vehicleType>

    <vehicleType id="metro">
        <description>Trem Metrô CCR Bahia</description>
        <capacity>
            <seats persons="300"/>
            <standingRoom persons="600"/>
        </capacity>
        <length meter="55.0"/>
        <width meter="3.0"/>
        <accessTime secondsPerPerson="0.3"/>
        <egressTime secondsPerPerson="0.3"/>
        <doorOperation mode="parallel"/>
        <passengerCarEquivalents pce="3.0"/>
    </vehicleType>

